<?xml version="1.0" encoding="utf-8"?>
<!-- Circular thumb for the home connect toggle. Colours are baked in here (no thumbTint)
     so the drop shadow survives; the switch has useMaterialThemeColors="false" to avoid
     a default tint. A transparent full-size layer fixes the bounds to the track height
     (44dp); soft, downward-offset dark circles behind the white oval form the shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent spacer: fixes the thumb bounds to the track height (44dp) -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="44dp"
                android:height="44dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Soft outer shadow, offset slightly down -->
    <item
        android:width="42dp"
        android:height="42dp"
        android:gravity="center"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Tighter, darker shadow, offset slightly down -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>

    <!-- Visible white thumb, centred -->
    <item
        android:width="38dp"
        android:height="38dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>

</layer-list>
