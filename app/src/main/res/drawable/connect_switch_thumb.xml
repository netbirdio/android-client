<?xml version="1.0" encoding="utf-8"?>
<!-- Circular thumb for the home connect toggle. The white colour is baked in here (no
     thumbTint); the switch has useMaterialThemeColors="false" to avoid a default tint.
     A transparent full-size layer fixes the bounds to the track height (44dp); the
     visible white oval is a smaller, centred item that floats inside the track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent spacer: fixes the thumb bounds to the track height (44dp) -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="44dp"
                android:height="44dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Visible white thumb, centred -->
    <item
        android:width="38dp"
        android:height="38dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>

</layer-list>
