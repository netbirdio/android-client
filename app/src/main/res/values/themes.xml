<resources>
    <!-- Base application theme. -->
    <style name="Theme.NetBird" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/nb_orange</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#89F58431</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/nb_gray_dark</item>

        <!-- Default background color -->
        <item name="android:windowBackground">@color/nb_bg</item>

        <item name="android:textColor">@color/nb_txt</item>


        <!-- Peer and Network bottom Button background -->
        <item name="colorSurface">@color/white</item>
        <item name="nbTabBackground">@color/nb_gray_bg</item>

        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>
    </style>

    <style name="Theme.NetBird.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.NetBird.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="android:textColorPrimary">@color/nb_txt</item>
    </style>

    <style name="Theme.NetBird.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- for peers fragment -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="colorPrimary">@color/nb_orange</item>
        <item name="colorSurface">@color/nb_sheet_bg</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.NetBird.BottomSheet</item>
    </style>

    <style name="Widget.NetBird.BottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_bg</item>
    </style>


    <!-- for MaterialCardView, bottom button -->
    <style name="TopRoundedCorners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">25dp</item>
        <item name="cornerSizeTopRight">25dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <attr name="nbTabBackground" format="color|reference" />

    <!-- MaterialComponents-based so Material widgets inside custom dialog
         layouts (switches, buttons) resolve the NetBird palette instead of
         falling back to the framework's default purple accent. -->
    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorPrimary">@color/nb_orange</item>
        <item name="colorAccent">@color/nb_orange</item>
        <item name="colorSecondary">@color/nb_orange</item>
        <item name="android:textColorPrimary">@color/nb_txt</item>
    </style>

    <!-- Day-mode definition for Theme.NetBird.Card (mirrors values-night) -->
    <style name="Theme.NetBird.Card" parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- Reusable TextAppearance for profile name to avoid repeating attributes in layouts -->
    <style name="TextAppearance.NetBird.ProfileName" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/nb_txt</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/nb_txt_light</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!--
      Button hierarchy shared by the profile dialog and the profile cards,
      mirroring the desktop app's primary / secondary / danger variants: one
      filled accent action, quiet outlined and text actions around it, red for
      destructive ones. The filled accent is reserved for a screen's single
      main action so a list of cards does not turn into a wall of orange.
    -->
    <style name="Widget.NetBird.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/dialog_btn_primary_bg</item>
        <item name="cornerRadius">6dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.NetBird.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_btn_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/nb_orange_15</item>
        <item name="strokeColor">@color/nb_chip_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.NetBird.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_btn_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="Widget.NetBird.Button.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_btn_danger_text</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/nb_danger</item>
    </style>

    <!-- List-row switch matching the home connect toggle: orange track when on, grey with a
         thin border when off, white thumb. useMaterialThemeColors must stay false or the
         theme tint paints over the colours baked into the drawables. -->
    <style name="Widget.NetBird.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:thumb">@drawable/nb_switch_thumb</item>
        <item name="track">@drawable/nb_switch_track</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:switchMinWidth">34dp</item>
    </style>
</resources>