<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_swap_vert"
        app:tint="@color/nb_txt" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/peer_detail_transfer"
        android:textColor="@color/nb_txt"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/peer_detail_bytes_received"
            android:src="@drawable/ic_arrow_down_small"
            app:tint="@color/nb_transfer_rx" />

        <TextView
            android:id="@+id/peer_detail_bytes_rx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/nb_txt_light"
            android:textSize="14sp"
            tools:text="1.2 MB" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@string/peer_detail_bytes_sent"
            android:src="@drawable/ic_arrow_up_small"
            app:tint="@color/nb_orange" />

        <TextView
            android:id="@+id/peer_detail_bytes_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="@color/nb_txt_light"
            android:textSize="14sp"
            tools:text="340 KB" />

    </LinearLayout>

</LinearLayout>
