<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    tools:context=".ui.ssh.SSHTerminalFragment">

    <WebView
        android:id="@+id/terminal_web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1a1a1a"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/key_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/key_esc"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:text="Esc"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_tab"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:text="Tab"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_ctrl"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:text="Ctrl"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_alt"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:minWidth="48dp"
                android:text="Alt"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_up"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:text="↑"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_down"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:text="↓"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_left"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:minWidth="48dp"
                android:text="←"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/key_right"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:text="→"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
