<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg"
    android:orientation="vertical"
    tools:context=".ui.home.PeerDetailFragment">

    <!-- No back arrow or title here: the activity toolbar already provides both via
         setupActionBarWithNavController. This row only carries the peer identity. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <View
            android:id="@+id/peer_detail_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/peer_status_disconnected" />

        <TextView
            android:id="@+id/peer_detail_fqdn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/nb_txt"
            android:textSize="16sp"
            tools:text="mypeer.example.netbird.cloud" />

        <ImageView
            android:id="@+id/peer_detail_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/peer_detail_refresh"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/nb_txt_light" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/peer_detail_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
