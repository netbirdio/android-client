<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/peer_detail_row_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        app:tint="@color/nb_txt"
        tools:src="@drawable/ic_speed" />

    <TextView
        android:id="@+id/peer_detail_row_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:maxLines="1"
        android:textColor="@color/nb_txt"
        android:textSize="14sp"
        tools:text="Latency" />

    <!-- Values stay on one line; the fragment picks where to clip per row. -->
    <TextView
        android:id="@+id/peer_detail_row_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:gravity="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="@color/nb_txt_light"
        android:textSize="14sp"
        tools:text="12 ms" />

    <ImageView
        android:id="@+id/peer_detail_row_copy"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/peer_detail_copy"
        android:padding="5dp"
        android:src="@drawable/ic_content_copy"
        android:visibility="gone"
        app:tint="@color/nb_txt_light"
        tools:visibility="visible" />

</LinearLayout>
