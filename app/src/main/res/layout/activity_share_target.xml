<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg_peers"
    android:orientation="vertical"
    tools:context=".ui.files.ShareTargetActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/share_thumbnail"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_rounded_nb_bg"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_segment_send"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/nb_txt_light" />

        <TextView
            android:id="@+id/share_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/nb_txt"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_cancel_dialog"
            app:layout_constraintStart_toEndOf="@id/share_thumbnail"
            app:layout_constraintTop_toTopOf="@id/share_thumbnail"
            tools:text="IMG_2481.jpg" />

        <TextView
            android:id="@+id/share_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/nb_txt_light"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btn_cancel_dialog"
            app:layout_constraintStart_toStartOf="@id/share_title"
            app:layout_constraintTop_toBottomOf="@id/share_title"
            tools:text="2.4 MB · JPEG image" />

        <TextView
            android:id="@+id/btn_cancel_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="0dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_close"
            android:textColor="@color/nb_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/share_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/share_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:autofillHints=""
        android:background="@drawable/search_bg"
        android:drawableStart="@drawable/search"
        android:drawableTint="@color/nb_txt_light"
        android:drawablePadding="10dp"
        android:hint="@string/peers_hint_search_peers"
        android:inputType="text"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:textColor="@color/nb_txt"
        android:textColorHint="@color/nb_txt_light" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/peer_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/share_list_bottom_padding"
            tools:listitem="@layout/list_item_peer_picker" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:text="@string/file_drop_share_no_peers"
            android:textAlignment="center"
            android:textColor="@color/nb_txt_light"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
