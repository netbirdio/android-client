<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg_home"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false"
    tools:context=".ui.home.HomeFragment">

    <!-- Profile chip, top-center -->
    <LinearLayout
        android:id="@+id/profile_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/profile_chip_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/peer_status_connected" />

        <TextView
            android:id="@+id/profile_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/nb_txt"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="default" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/nb_txt" />
    </LinearLayout>

    <!-- NetBird logo. Head of a packed vertical chain (logo → switch → status →
         hostname → address rows) centered between the profile chip and the exit
         node row, so the group can never overlap either. -->
    <ImageView
        android:id="@+id/home_logo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/main_desc_logo"
        android:focusable="false"
        android:scaleType="fitCenter"
        android:src="@drawable/nb_logo_full"
        app:layout_constraintTop_toBottomOf="@id/profile_chip"
        app:layout_constraintBottom_toTopOf="@+id/btn_connect"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.42" />

    <!-- Connect toggle -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/btn_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="@string/main_desc_connect"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:switchMinWidth="92dp"
        android:thumb="@drawable/connect_switch_thumb"
        app:track="@drawable/connect_switch_track"
        app:useMaterialThemeColors="false"
        app:layout_constraintTop_toBottomOf="@id/home_logo"
        app:layout_constraintBottom_toTopOf="@+id/text_connection_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Connection status -->
    <TextView
        android:id="@+id/text_connection_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/inter_variable"
        android:focusable="false"
        android:textAlignment="center"
        android:textColor="@color/nb_txt"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btn_connect"
        app:layout_constraintBottom_toTopOf="@+id/text_hostname"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="@string/main_status_disconnected" />

    <!-- IP / network address (monospace, emphasized) -->
    <TextView
        android:id="@+id/text_hostname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/jetbrains_mono_variable"
        android:focusable="false"
        android:textAlignment="center"
        android:textColor="@color/nb_txt"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/text_connection_status"
        app:layout_constraintBottom_toTopOf="@+id/network_address_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="sdk-phone-x86-64.netbird.cloud" />

    <!-- Hostname summary (muted) + chevron. Tapping toggles the info rows below. -->
    <LinearLayout
        android:id="@+id/network_address_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/focus_highlight"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/text_hostname"
        app:layout_constraintBottom_toTopOf="@+id/info_rows"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_network_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_variable"
            android:focusable="false"
            android:textAlignment="center"
            android:textColor="@color/nb_txt_light"
            android:textSize="14sp"
            tools:text="100.72.68.65/16" />

        <ImageView
            android:id="@+id/info_rows_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/nb_txt_light" />
    </LinearLayout>

    <!-- Info rows: IP address + secondary value. Hidden until the summary above is tapped. -->
    <LinearLayout
        android:id="@+id/info_rows"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/info_row_bg"
        android:divider="@drawable/info_row_divider"
        android:orientation="vertical"
        android:showDividers="middle"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/network_address_summary"
        app:layout_constraintBottom_toTopOf="@+id/exit_node_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Primary: IP / CIDR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/text_ip_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jetbrains_mono_variable"
                android:textColor="@color/nb_txt"
                android:textSize="12sp"
                tools:text="100.72.74.247/16" />

            <ImageButton
                android:id="@+id/btn_copy_ip"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/focus_highlight"
                android:contentDescription="@string/main_desc_copy"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/nb_txt_light" />
        </LinearLayout>

        <!-- Secondary value (IPv6). Only shown when an IPv6 address is available. -->
        <LinearLayout
            android:id="@+id/secondary_value_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_secondary_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="@font/jetbrains_mono_variable"
                android:singleLine="true"
                android:text="@string/main_value_empty"
                android:textColor="@color/nb_txt"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_copy_secondary"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/focus_highlight"
                android:contentDescription="@string/main_desc_copy"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/nb_txt_light" />
        </LinearLayout>

    </LinearLayout>

    <!-- Exit node selector, pinned to the bottom like the desktop main view.
         Always shown; disabled and dimmed while there is no exit node to pick
         (disconnected, or none shared with this peer). -->
    <LinearLayout
        android:id="@+id/exit_node_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.5"
        android:background="@drawable/info_row_bg"
        android:clickable="true"
        android:enabled="false"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/exit_node_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/networks_desc_exit_node"
            android:src="@drawable/exit"
            app:tint="@color/nb_txt_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_node_title"
                android:textColor="@color/nb_txt"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exit_node_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_node_unavailable"
                android:textColor="@color/nb_txt_light"
                android:textSize="13sp"
                tools:text="aws-frankfurt" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="@color/nb_txt_light" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
