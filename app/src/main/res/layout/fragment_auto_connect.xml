<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/nb_bg_peers"
    android:fillViewport="true"
    tools:context=".ui.autoconnect.AutoConnectFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Section: Networks -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/auto_connect_networks_header" />

        <LinearLayout
            android:id="@+id/layout_connect_on_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi"
                app:tint="@color/nb_txt_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/auto_connect_connect_on_wifi"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/nb_txt_light" />

            <include layout="@layout/list_item_setting_vertical_divider" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_connect_on_wifi"
                style="@style/Widget.NetBird.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_connect_on_mobile_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cellular"
                app:tint="@color/nb_txt_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/auto_connect_connect_on_mobile_data"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_connect_on_mobile_data"
                style="@style/Widget.NetBird.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_connect_on_ethernet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cable"
                app:tint="@color/nb_txt_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/auto_connect_connect_on_ethernet"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_connect_on_ethernet"
                style="@style/Widget.NetBird.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_disconnect_on_no_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/nb_txt_light" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/auto_connect_disconnect_on_no_network"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_disconnect_on_no_network"
                style="@style/Widget.NetBird.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_permission_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_rounded_nb_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_connect_notification_permission_warning"
                android:textColor="@color/nb_orange"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_banner_enable_notifications"
                style="@style/Widget.NetBird.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_marginTop="8dp"
                android:text="@string/auto_connect_enable_notifications" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/battery_optimization_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:background="@drawable/bg_rounded_nb_bg"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_connect_battery_optimization_warning"
                android:textColor="@color/nb_orange"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_banner_ignore_battery_optimizations"
                style="@style/Widget.NetBird.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_marginTop="8dp"
                android:text="@string/auto_connect_allow_unrestricted_battery" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>