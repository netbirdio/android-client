<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scr_vw_advanced"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg"
    android:fillViewport="true"
    tools:context=".ui.advanced.AdvancedFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Section: Pre-shared Key -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/advanced_section_presharedkey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nb_bg_peers"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/preshared_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:background="@drawable/edit_text_white_focusable"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:focusedByDefault="false"
                android:hint="@string/advanced_hint"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="@color/nb_txt"
                android:textColorHint="@color/nb_txt_light"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_bg_orange"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:foreground="@drawable/focus_highlight"
                android:text="@string/advanced_save"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/advanced_details"
                android:textColor="@color/nb_txt_light"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Section: Rosenpass -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/advanced_section_rosenpass" />

        <LinearLayout
            android:id="@+id/layout_rosenpas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/advanced_rosenpass"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_rosenpass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_rosenpass_permissive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/advanced_rosenpass_permissive"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_rosenpass_permissive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- Section: Network & Security -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/advanced_title_network_security" />

        <LinearLayout
            android:id="@+id/layout_allow_ssh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_allow_ssh"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_allow_ssh_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_allow_ssh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_block_inbound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_block_inbound"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_block_inbound_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_block_inbound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_disable_client_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_disable_client_routes"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_disable_client_routes_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_disable_client_routes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_disable_server_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_disable_server_routes"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_disable_server_routes_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_disable_server_routes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_disable_dns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_disable_dns"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_disable_dns_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_disable_dns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_disable_firewall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_disable_firewall"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_disable_firewall_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_disable_firewall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_disable_ipv6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_disable_ipv6"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_disable_ipv6_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_disable_ipv6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <include layout="@layout/list_item_setting_divider" />

        <LinearLayout
            android:id="@+id/layout_force_relay_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/advanced_force_relay_conn"
                    android:textColor="@color/nb_txt"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/advanced_force_relay_conn_desc"
                    android:textColor="@color/nb_txt_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                style="@style/Widget.NetBird.Switch"
                android:id="@+id/switch_force_relay_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <!-- Section: Appearance -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/advanced_section_appearance" />

        <LinearLayout
            android:id="@+id/row_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/advanced_theme_title"
                android:textColor="@color/nb_txt"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/theme_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/nb_txt_light"
                android:textSize="14sp"
                tools:text="System" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/nb_txt_light" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
